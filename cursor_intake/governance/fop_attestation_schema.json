{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FOPAttestation",
  "description": "Federation Onboarding Protocol Attestation Format",
  "type": "object",
  "required": [
    "did",
    "articles_fingerprint",
    "judicial_slo",
    "audit_root",
    "timestamp",
    "jws"
  ],
  "properties": {
    "did": {
      "type": "string",
      "description": "Decentralized identifier of attesting jurisdiction",
      "pattern": "^did:airep:[a-f0-9]{64}$",
      "examples": ["did:airep:a1b2c3d4e5f6789012345678901234567890123456789012345678901234567890"]
    },
    "articles_fingerprint": {
      "type": "string",
      "description": "SHA-256 hash of immutable Articles I-II",
      "pattern": "^[a-f0-9]{64}$",
      "examples": ["8b0f4c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4"]
    },
    "judicial_slo": {
      "type": "object",
      "description": "Service Level Objectives for judicial system",
      "required": ["engine_ms_p95", "api_ms_p95", "quarantine_to_action_ms_p95"],
      "properties": {
        "engine_ms_p95": {
          "type": "number",
          "description": "95th percentile judicial engine response time",
          "minimum": 1,
          "maximum": 20,
          "examples": [10]
        },
        "api_ms_p95": {
          "type": "number",
          "description": "95th percentile judicial API response time",
          "minimum": 50,
          "maximum": 200,
          "examples": [120]
        },
        "quarantine_to_action_ms_p95": {
          "type": "number",
          "description": "95th percentile quarantine to action time",
          "minimum": 500,
          "maximum": 2000,
          "examples": [800]
        },
        "uptime_percent": {
          "type": "number",
          "description": "System uptime percentage (last 30 days)",
          "minimum": 99.0,
          "maximum": 100.0,
          "examples": [99.95]
        },
        "false_positive_rate": {
          "type": "number",
          "description": "False positive rate in judicial decisions",
          "minimum": 0.0,
          "maximum": 0.01,
          "examples": [0.005]
        }
      }
    },
    "runtime_slo": {
      "type": "object",
      "description": "Service Level Objectives for constitutional runtime",
      "properties": {
        "validation_ms_p95": {
          "type": "number",
          "description": "95th percentile constitutional validation time",
          "minimum": 1,
          "maximum": 15,
          "examples": [8]
        },
        "compliance_rate_percent": {
          "type": "number",
          "description": "Constitutional compliance rate",
          "minimum": 99.9,
          "maximum": 100.0,
          "examples": [99.95]
        },
        "drift_detection_ms": {
          "type": "number",
          "description": "Drift detection response time",
          "minimum": 1,
          "maximum": 50,
          "examples": [12]
        }
      }
    },
    "audit_root": {
      "type": "string",
      "description": "Merkle root of recent constitutional audit trail",
      "pattern": "^[a-f0-9]{64}$",
      "examples": ["c9a1b2c3d4e5f6789012345678901234567890123456789012345678901234567"]
    },
    "evidence_capabilities": {
      "type": "object",
      "description": "Evidence generation and privacy capabilities",
      "properties": {
        "supported_categories": {
          "type": "array",
          "description": "Evidence categories jurisdiction can produce",
          "items": {
            "type": "string",
            "enum": [
              "drift_pattern",
              "quarantine_outcome",
              "tribunal_summary",
              "policy_delta",
              "threat_indicator",
              "performance_anomaly",
              "security_incident",
              "constitutional_event"
            ]
          },
          "minItems": 1,
          "examples": [["drift_pattern", "quarantine_outcome", "tribunal_summary"]]
        },
        "privacy_features": {
          "type": "object",
          "properties": {
            "differential_privacy": {
              "type": "boolean",
              "description": "DP implementation available",
              "examples": [true]
            },
            "k_anonymity": {
              "type": "boolean",
              "description": "K-anonymity bucketing available",
              "examples": [true]
            },
            "default_epsilon": {
              "type": "number",
              "description": "Default differential privacy epsilon",
              "minimum": 0.1,
              "maximum": 1.0,
              "examples": [0.3]
            },
            "default_k": {
              "type": "integer",
              "description": "Default k-anonymity bucket size",
              "minimum": 3,
              "maximum": 20,
              "examples": [5]
            }
          }
        },
        "evidence_generation_rate": {
          "type": "object",
          "properties": {
            "max_per_hour": {
              "type": "integer",
              "description": "Maximum evidence items per hour",
              "minimum": 1,
              "maximum": 1000,
              "examples": [60]
            },
            "typical_per_hour": {
              "type": "integer",
              "description": "Typical evidence generation rate",
              "minimum": 1,
              "maximum": 100,
              "examples": [12]
            }
          }
        }
      }
    },
    "federation_commitments": {
      "type": "object",
      "description": "Jurisdiction's federation participation commitments",
      "properties": {
        "treaty_acceptance": {
          "type": "string",
          "description": "Accepted treaty version",
          "enum": ["FOP-1.0"],
          "examples": ["FOP-1.0"]
        },
        "evidence_sharing_level": {
          "type": "string",
          "description": "Committed evidence sharing level",
          "enum": ["minimal", "standard", "comprehensive"],
          "examples": ["standard"]
        },
        "response_commitments": {
          "type": "object",
          "properties": {
            "threat_response_time_hours": {
              "type": "number",
              "description": "Maximum response time to federation threats",
              "minimum": 1,
              "maximum": 24,
              "examples": [4]
            },
            "evidence_ack_sla_ms": {
              "type": "number",
              "description": "Evidence acknowledgment SLA",
              "minimum": 100,
              "maximum": 1000,
              "examples": [300]
            }
          }
        },
        "extended_policies": {
          "type": "array",
          "description": "Additional treaty policies accepted",
          "items": {
            "type": "string",
            "enum": [
              "threat_sharing",
              "coordinated_response",
              "resource_sharing",
              "joint_research"
            ]
          },
          "examples": [["threat_sharing"]]
        }
      }
    },
    "security_posture": {
      "type": "object",
      "description": "Security capabilities and certifications",
      "properties": {
        "cryptographic_implementations": {
          "type": "object",
          "properties": {
            "ed25519_signing": {
              "type": "boolean",
              "description": "Ed25519 signature support",
              "examples": [true]
            },
            "mtls_client": {
              "type": "boolean",
              "description": "mTLS client certificate support",
              "examples": [true]
            },
            "jws_detached": {
              "type": "boolean",
              "description": "Detached JWS signature support",
              "examples": [true]
            },
            "key_rotation_automation": {
              "type": "boolean",
              "description": "Automated key rotation capability",
              "examples": [true]
            }
          }
        },
        "audit_capabilities": {
          "type": "object",
          "properties": {
            "immutable_audit_trail": {
              "type": "boolean",
              "description": "Immutable audit trail implementation",
              "examples": [true]
            },
            "real_time_auditing": {
              "type": "boolean",
              "description": "Real-time audit generation",
              "examples": [true]
            },
            "audit_retention_years": {
              "type": "integer",
              "description": "Audit retention period in years",
              "minimum": 1,
              "maximum": 10,
              "examples": [7]
            }
          }
        },
        "certifications": {
          "type": "array",
          "description": "Security certifications and attestations",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "examples": [["ISO 27001", "SOC 2 Type II"]]
        }
      }
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp of attestation creation",
      "minimum": 1609459200,
      "examples": [1734567890.123]
    },
    "validity_period_days": {
      "type": "integer",
      "description": "Attestation validity period",
      "minimum": 30,
      "maximum": 365,
      "default": 90,
      "examples": [90]
    },
    "jws": {
      "type": "string",
      "description": "Detached JWS signature over canonical JSON",
      "minLength": 100,
      "examples": ["eyJhbGciOiJFZERTQSJ9..signature_here"]
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for processing",
      "properties": {
        "jurisdiction_name": {
          "type": "string",
          "description": "Human-readable jurisdiction name",
          "maxLength": 100,
          "examples": ["Research AI Collective"]
        },
        "contact_email": {
          "type": "string",
          "description": "Administrative contact email",
          "format": "email",
          "examples": ["federation@research.ai"]
        },
        "geographic_region": {
          "type": "string",
          "description": "Geographic region identifier",
          "examples": ["us-west", "eu-central"]
        },
        "specializations": {
          "type": "array",
          "description": "Jurisdiction specializations",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "examples": [["healthcare_ai", "research_focused"]]
        }
      }
    }
  },
  "additionalProperties": false
}
