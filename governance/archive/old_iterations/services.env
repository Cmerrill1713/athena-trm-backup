# Service URLs Configuration
# Source this file before starting the stack: source config/services.env

# Core Stack (auto-started with make stack-up)
export UAT_BASE=http://127.0.0.1:8181
export ATHENA_BASE=http://127.0.0.1:8090
export BRIDGE_BASE=http://127.0.0.1:8014

# Voice Layer (start with: make stack-voice)
export KOKORO_TTS_URL=http://127.0.0.1:8020
export KOKORO_VOICE=af_heart

# RAG Layer (start with: make stack-rag)
export RAG_URL=http://127.0.0.1:8015
export ENABLE_RAG=0  # Set to 1 when RAG service is running

# Vision Layer (start with: make stack-vision)
export FASTVLM_URL=http://127.0.0.1:8811
export VISION_RAG_URL=http://127.0.0.1:8016
export ENABLE_VISION=0  # Set to 1 when vision services running

# Weaviate (Vector DB) - FIXED PORT (was 8090, conflicted with Athena!)
export WEAVIATE_URL=http://127.0.0.1:8095
export WEAVIATE_ENABLED=0  # Set to 1 if Weaviate is running

# Observability (start with: make monitoring-up)
export OTLP_ENDPOINT=http://localhost:4318/v1/traces
export PROMETHEUS_URL=http://localhost:9090
export GRAFANA_URL=http://localhost:3001

# Feature Flags
export META_PROMPTING=1
export META_REFLECTION=1
export META_RAG=${ENABLE_RAG}
export META_SELFCRITIQUE=1
export META_CHAINING=1

# Usage Examples:
# source config/services.env
# make stack-up           # Core only
# make stack-voice        # Add voice
# make stack-full         # Everything
