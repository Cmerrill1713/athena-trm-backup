[flake8]
max-line-length = 100
extend-ignore = E203,W503

# Exclude known problematic/demo files
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    .build,
    .derived,
    DerivedData,
    node_modules,
    external,
    backups,
    archive,
    kokoro-venv,
    .mypy_cache,
    .pytest_cache,
    .tox,
    # Broken demo files
    scripts/demo_governance_drift_detection.py,
    scripts/demo_governance_drift_detection_fixed.py,
    scripts/integrate_governance_drift_detection.py,
    # Spike/experimental files
    spikes.py,
    triggers.py,
    # Large demo files with many warnings
    scripts/vision_smoke_test.py,
    voice_activation.py

# Per-file ignores for pragmatic exceptions
per-file-ignores =
    # Tests: allow pragmatic patterns
    tests/*: E712,E731,F401,F841,E402,E722
    test_*.py: E712,E731,F401,F841,E402,E722
    # Scripts: allow bare except and import order flexibility
    scripts/*: E722,E402
    # Specific problematic files
    scripts/knowledge_helper.py: E402,E722
    scripts/layered_amendment_protocol.py: F402,F841
    scripts/pick_provider.py: E722
