import SwiftUI

// MARK: - Modern Athena Dashboard with NavigationStack

struct AthenaDashboard: View {
    @State private var navigationPath = NavigationPath()
    @StateObject private var athena = ModernAthenaViewModel()

    var body: some View {
        NavigationStack(path: $navigationPath) {
            // Home Dashboard
            DashboardHomeView()
                .navigationTitle("Athena Control Center")
                .navigationBarTitleDisplayMode(.large)
                .toolbar {
                    ToolbarItem(placement: .topBarTrailing) {
                        Button {
                            navigationPath.append(DashboardDestination.settings)
                        } label: {
                            Label("Settings", systemImage: "gear")
                        }
                    }

                    ToolbarItem(placement: .topBarTrailing) {
                        Menu {
                            Button {
                                Task { await athena.refreshAll() }
                            } label: {
                                Label("Refresh All", systemImage: "arrow.clockwise")
                            }

                            Button {
                                athena.acknowledgeAllAlerts()
                            } label: {
                                Label("Acknowledge All Alerts", systemImage: "checkmark.circle")
                            }

                            Divider()

                            Button {
                                athena.sendTestAlert()
                            } label: {
                                Label("Test Alert System", systemImage: "hammer.circle")
                            }

                            Button {
                                athena.openLogs()
                            } label: {
                                Label("View Logs", systemImage: "doc.text.magnifyingglass")
                            }
                        } label: {
                            Label("Actions", systemImage: "ellipsis.circle")
                        }
                    }
                }
                .navigationDestination(for: DashboardDestination.self) { destination in
                    switch destination {
                    case .systemHealth:
                        SystemHealthDetailView()
                            .environmentObject(athena)
                    case .alerts:
                        AlertsDetailView()
                            .environmentObject(athena)
                    case .metrics:
                        MetricsDetailView()
                            .environmentObject(athena)
                    case .settings:
                        DashboardSettingsView()
                            .environmentObject(athena)
                    case .focus:
                        FocusIntegrationView()
                    case .calendar:
                        CalendarIntegrationView()
                    case .learning:
                        BehavioralLearningView()
                    }
                }
        }
        .frame(minWidth: 900, minHeight: 700)
        .environmentObject(athena)
        .task {
            await athena.startMonitoring()
        }
    }
}

// MARK: - Dashboard Home View

struct DashboardHomeView: View {
    @EnvironmentObject private var athena: ModernAthenaViewModel

    var body: some View {
        ScrollView {
            VStack(spacing: 24) {
                // System Status Overview
                SystemStatusCard()
                    .environmentObject(athena)

                // Quick Actions Grid
                QuickActionsGrid()

                // Active Alerts
                if !athena.alerts.filter({ !$0.acknowledged }).isEmpty {
                    ActiveAlertsCard()
                        .environmentObject(athena)
                }

                // Recent Activity
                RecentActivityCard()
                    .environmentObject(athena)

                // System Metrics Summary
                MetricsSummaryCard()
                    .environmentObject(athena)
            }
            .padding()
        }
    }
}

// MARK: - System Status Card

struct SystemStatusCard: View {
    @EnvironmentObject private var athena: ModernAthenaViewModel

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            HStack {
                Label("System Status", systemImage: "circle.grid.3x3.fill")
                    .font(.title2.bold())
                Spacer()
                ConnectionIndicator(isConnected: athena.isConnected)
            }

            HStack(spacing: 24) {
                StatusMetricView(
                    title: "Services",
                    value: "\(athena.services.filter { $0.status == .running }.count)/\(athena.services.count)",
                    icon: "server.rack",
                    color: .blue
                )

                StatusMetricView(
                    title: "Active Alerts",
                    value: "\(athena.alerts.filter { !$0.acknowledged }.count)",
                    icon: "exclamationmark.triangle",
                    color: athena.alerts.contains { !$0.acknowledged && $0.severity == .critical } ? .red : .orange
                )

                StatusMetricView(
                    title: "Health Score",
                    value: String(format: "%.0f%%", athena.systemHealth.healthScore * 100),
                    icon: "heart.fill",
                    color: athena.systemHealth.healthScore > 0.8 ? .green : .yellow
                )
            }

            if athena.isQuietHoursActive {
                HStack {
                    Image(systemName: "moon.fill")
                        .foregroundStyle(.purple)
                    Text("Quiet Hours Active")
                        .font(.caption)
                        .foregroundStyle(.secondary)
                    Spacer()
                    Text("Alerts Queued: \(athena.queuedAlerts.count)")
                        .font(.caption)
                        .foregroundStyle(.secondary)
                }
                .padding(.vertical, 8)
                .padding(.horizontal, 12)
                .background(Color.purple.opacity(0.1))
                .clipShape(RoundedRectangle(cornerRadius: 8))
            }
        }
        .padding()
        .background(.ultraThinMaterial)
        .clipShape(RoundedRectangle(cornerRadius: 16))
    }
}

struct ConnectionIndicator: View {
    let isConnected: Bool

    var body: some View {
        HStack(spacing: 4) {
            Circle()
                .fill(isConnected ? Color.green : Color.red)
                .frame(width: 8, height: 8)
            Text(isConnected ? "Connected" : "Disconnected")
                .font(.caption)
                .foregroundStyle(.secondary)
        }
    }
}

