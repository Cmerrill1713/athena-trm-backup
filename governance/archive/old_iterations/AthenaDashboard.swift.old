// MARK: - Legacy Athena State Management (for backward compatibility)

class AthenaState: ObservableObject {
    @Published var currentTab: AthenaTab = .status
    @Published var services: [AthenaService] = []
    @Published var alerts: [AthenaAlert] = []
    @Published var metrics: AthenaMetrics = AthenaMetrics()
    @Published var isConnected = false
    @Published var lastUpdate = Date()

    // Quiet Hours
    @Published var quietHoursEnabled = false
    @Published var quietHoursStart = 22 // 10 PM
    @Published var quietHoursEnd = 8   // 8 AM
    @Published var queuedAlertsDuringQuiet: [AthenaAlert] = []
    @Published var isCurrentlyQuietHours = false

    private var monitoringTimer: Timer?
    private var quietHoursCheckTimer: Timer?
    private let apiClient = AthenaAPIClient()

    init() {
        loadInitialState()
    }

    func startMonitoring() {
        monitoringTimer = Timer.scheduledTimer(withTimeInterval: 5.0, repeats: true) { [weak self] _ in
            self?.refreshStatus()
        }

        // Check quiet hours every minute
        quietHoursCheckTimer = Timer.scheduledTimer(withTimeInterval: 60.0, repeats: true) { [weak self] _ in
            self?.updateQuietHoursStatus()
            self?.deliverQueuedAlertsIfNeeded()
        }

        refreshAll()
        updateQuietHoursStatus()
    }

    func stopMonitoring() {
        monitoringTimer?.invalidate()
        monitoringTimer = nil
        quietHoursCheckTimer?.invalidate()
        quietHoursCheckTimer = nil
    }

    func refreshAll() {
        refreshStatus()
        refreshAlerts()
        refreshMetrics()
    }

    func refreshStatus() {
        apiClient.getStatus { [weak self] result in
            DispatchQueue.main.async {
                switch result {
                case .success(let status):
                    self?.services = status.services
                    self?.isConnected = true
                    self?.lastUpdate = Date()
                case .failure(let error):
                    self?.isConnected = false
                    print("Failed to get status: \(error)")
                }
            }
        }
    }

    func refreshAlerts() {
        apiClient.getAlerts { [weak self] result in
            DispatchQueue.main.async {
                switch result {
                case .success(let alerts):
                    self?.alerts = alerts
                case .failure(let error):
                    print("Failed to get alerts: \(error)")
                }
            }
        }
    }

    func refreshMetrics() {
        apiClient.getMetrics { [weak self] result in
            DispatchQueue.main.async {
                switch result {
                case .success(let metrics):
                    self?.metrics = metrics
                case .failure(let error):
                    print("Failed to get metrics: \(error)")
                }
            }
        }
    }

    func acknowledgeAlert(_ alert: AthenaAlert) {
        apiClient.acknowledgeAlert(alert.id) { [weak self] result in
            DispatchQueue.main.async {
                switch result {
                case .success:
                    self?.refreshAlerts()
                case .failure(let error):
                    print("Failed to acknowledge alert: \(error)")
                }
            }
        }
    }

    func acknowledgeAllAlerts() {
        let unacknowledged = alerts.filter { !$0.acknowledged }
        for alert in unacknowledged {
            acknowledgeAlert(alert)
        }
    }

    func updateCadence(service: String, newCadence: Int) {
        apiClient.updateCadence(service: service, cadence: newCadence) { [weak self] result in
            DispatchQueue.main.async {
                switch result {
                case .success:
                    self?.refreshStatus()
                case .failure(let error):
                    print("Failed to update cadence: \(error)")
                }
            }
        }
    }

    func sendTestAlert() {
        apiClient.sendTestAlert { result in
            DispatchQueue.main.async {
                switch result {
                case .success:
                    print("Test alert sent")
                case .failure(let error):
                    print("Failed to send test alert: \(error)")
                }
            }
        }
    }

    func openLogs() {
        // Open logs directory in Finder
        let logDir = "/tmp"  // Athena logs location
        NSWorkspace.shared.open(URL(fileURLWithPath: logDir))
    }

    // MARK: - Quiet Hours Logic

    func updateQuietHoursStatus() {
        guard quietHoursEnabled else {
            isCurrentlyQuietHours = false
            return
        }

        let now = Date()
        let calendar = Calendar.current
        let currentHour = calendar.component(.hour, from: now)

        // Check if we're in quiet hours range
        if quietHoursStart > quietHoursEnd {
            // Overnight range (e.g., 22:00 to 08:00)
            isCurrentlyQuietHours = currentHour >= quietHoursStart || currentHour < quietHoursEnd
        } else {
            // Same day range
            isCurrentlyQuietHours = currentHour >= quietHoursStart && currentHour < quietHoursEnd
        }
    }

    func shouldSendAlertNow(_ alert: AthenaAlert) -> Bool {
        // Critical alerts always go through, regardless of quiet hours
        if alert.severity == .critical {
            return true
        }

        // During quiet hours, only critical alerts are sent immediately
        return !isCurrentlyQuietHours
    }

    func queueAlertDuringQuietHours(_ alert: AthenaAlert) {
        queuedAlertsDuringQuiet.append(alert)
        print("Alert queued during quiet hours: \(alert.title)")
    }

    func deliverQueuedAlertsIfNeeded() {
        // Only deliver if we're no longer in quiet hours and have queued alerts
        guard !isCurrentlyQuietHours, !queuedAlertsDuringQuiet.isEmpty else { return }

        print("Delivering \(queuedAlertsDuringQuiet.count) queued alerts after quiet hours")

        // Add queued alerts to the main alerts list
        alerts.insert(contentsOf: queuedAlertsDuringQuiet, at: 0)

        // Clear the queue
        queuedAlertsDuringQuiet.removeAll()

        // Send a summary notification
        sendQuietHoursSummaryAlert()
    }

    func sendQuietHoursSummaryAlert() {
        let summaryAlert = AthenaAlert(
            id: "quiet-hours-summary-\(Int(Date().timeIntervalSince1970))",
            timestamp: Date(),
            severity: .info,
            title: "Quiet Hours Summary",
            message: "\(queuedAlertsDuringQuiet.count) alerts were suppressed during quiet hours and are now available for review.",
            acknowledged: false
        )

        alerts.insert(summaryAlert, at: 0)
    }

    func toggleQuietHours() {
        quietHoursEnabled.toggle()
        updateQuietHoursStatus()

        if quietHoursEnabled {
            print("Quiet hours enabled: \(quietHoursStart):00 - \(quietHoursEnd):00")
        } else {
            print("Quiet hours disabled")
            // Deliver any queued alerts immediately
            deliverQueuedAlertsIfNeeded()
        }
    }

    func setQuietHours(start: Int, end: Int) {
        quietHoursStart = start
        quietHoursEnd = end
        updateQuietHoursStatus()
        print("Quiet hours updated: \(start):00 - \(end):00")
    }

    var quietHoursDescription: String {
        guard quietHoursEnabled else { return "Disabled" }

        let startTime = String(format: "%02d:00", quietHoursStart)
        let endTime = String(format: "%02d:00", quietHoursEnd)

        return "\(startTime) - \(endTime)"
    }

    var quietHoursStatusDescription: String {
        if !quietHoursEnabled {
            return "Inactive"
        } else if isCurrentlyQuietHours {
            return "Active (alerts suppressed)"
        } else {
            return "Inactive (alerts enabled)"
        }
    }

    private func loadInitialState() {
        // Load initial mock data
        services = [
            AthenaService(name: "Memory Optimizer", status: .running, lastRun: Date().addingTimeInterval(-300), nextRun: Date().addingTimeInterval(3300), cadence: 3600),
            AthenaService(name: "Tribunal Monitor", status: .running, lastRun: Date().addingTimeInterval(-900), nextRun: Date().addingTimeInterval(600), cadence: 900),
            AthenaService(name: "Voice Wake Word", status: .running, lastRun: nil, nextRun: nil, cadence: nil),
            AthenaService(name: "Federation Sync", status: .idle, lastRun: Date().addingTimeInterval(-7200), nextRun: Date().addingTimeInterval(0), cadence: 7200)
        ]

        alerts = [
            AthenaAlert(id: "test-1", timestamp: Date().addingTimeInterval(-1800), severity: .info, title: "Memory Optimization Complete", message: "Successfully optimized memory usage by 35%", acknowledged: true),
            AthenaAlert(id: "test-2", timestamp: Date().addingTimeInterval(-600), severity: .warning, title: "High Memory Usage Detected", message: "Memory utilization at 85%. Optimization scheduled.", acknowledged: false)
        ]
    }
}

// MARK: - Data Models

enum AthenaTab: String, CaseIterable, Identifiable {
    case status, alerts, controls, focus, calendar, learning, metrics

    var id: String { rawValue }

    var title: String {
        switch self {
        case .status: return "Status"
        case .alerts: return "Alerts"
        case .controls: return "Controls"
        case .focus: return "Focus"
        case .calendar: return "Calendar"
        case .learning: return "Learning"
        case .metrics: return "Metrics"
        }
    }

    var icon: String {
        switch self {
        case .status: return "heart.circle.fill"
        case .alerts: return "exclamationmark.triangle.fill"
        case .controls: return "slider.horizontal.3"
        case .focus: return "moon.circle.fill"
        case .calendar: return "calendar.circle.fill"
        case .learning: return "brain.head.profile"
        case .metrics: return "chart.bar.fill"
        }
    }
}

struct AthenaService: Identifiable {
    let id = UUID()
    let name: String
    let status: ServiceStatus
    let lastRun: Date?
    let nextRun: Date?
    let cadence: Int? // seconds

    var nextRunDescription: String {
        guard let nextRun = nextRun else { return "Continuous" }
        let timeUntil = nextRun.timeIntervalSince(Date())
        if timeUntil <= 0 { return "Now" }
        return formatTimeInterval(timeUntil)
    }

    var lastRunDescription: String {
        guard let lastRun = lastRun else { return "Never" }
        let timeSince = -lastRun.timeIntervalSince(Date())
        return "\(formatTimeInterval(timeSince)) ago"
    }

    private func formatTimeInterval(_ interval: TimeInterval) -> String {
        let minutes = Int(interval / 60)
        if minutes < 60 {
            return "\(minutes)m"
        } else {
            let hours = minutes / 60
            return "\(hours)h"
        }
    }
}

enum ServiceStatus {
    case running, idle, error, stopped
}

struct AthenaAlert: Identifiable {
    let id: String
    let timestamp: Date
    let severity: AlertSeverity
    let title: String
    let message: String
    var acknowledged: Bool = false

    var timeAgo: String {
        let interval = -timestamp.timeIntervalSince(Date())
        let minutes = Int(interval / 60)
        if minutes < 60 {
            return "\(minutes)m ago"
        } else {
            let hours = minutes / 60
            return "\(hours)h ago"
        }
    }
}

enum AlertSeverity {
    case info, warning, error, critical

    var color: Color {
        switch self {
        case .info: return .blue
        case .warning: return .orange
        case .error: return .red
        case .critical: return .red
        }
    }

    var icon: String {
        switch self {
        case .info: return "info.circle"
        case .warning: return "exclamationmark.triangle"
        case .error: return "xmark.circle"
        case .critical: return "exclamationmark.triangle.fill"
        }
    }
}

struct AthenaMetrics {
    var memoryOptimizationSavings: Double = 0
    var tribunalScansToday: Int = 0
    var alertsTriggeredToday: Int = 0
    var averageResponseTime: Double = 0
    var systemHealthScore: Double = 0.95

    var memorySavingsDescription: String {
        return String(format: "%.1f%%", memoryOptimizationSavings * 100)
    }

    var responseTimeDescription: String {
        return String(format: "%.2fs", averageResponseTime)
    }

    var healthScoreDescription: String {
        return String(format: "%.1f%%", systemHealthScore * 100)
    }
}

// MARK: - API Client

class AthenaAPIClient {
    private let baseURL = "http://localhost:8009"  // Local Athena API
    private let session: URLSession

    init() {
        let config = URLSessionConfiguration.default
        config.timeoutIntervalForRequest = 5.0
        config.timeoutIntervalForResource = 10.0
        self.session = URLSession(configuration: config)
    }

    func getStatus(completion: @escaping (Result<AthenaStatus, Error>) -> Void) {
        guard let url = URL(string: "\(baseURL)/status") else {
            completion(.failure(NSError(domain: "AthenaAPI", code: -1, userInfo: [NSLocalizedDescriptionKey: "Invalid URL"])))
            return
        }

        let task = session.dataTask(with: url) { data, response, error in
            if let error = error {
                // Fall back to mock data if API unavailable
                self.fallbackToMockStatus(completion: completion)
                return
            }

            guard let data = data,
                  let httpResponse = response as? HTTPURLResponse,
                  httpResponse.statusCode == 200 else {
                self.fallbackToMockStatus(completion: completion)
                return
            }

            do {
                if let json = try JSONSerialization.jsonObject(with: data) as? [String: Any],
                   let servicesData = json["services"] as? [[String: Any]] {

                    let services = servicesData.compactMap { serviceData -> AthenaService? in
                        guard let name = serviceData["name"] as? String,
                              let statusString = serviceData["status"] as? String else { return nil }

                        let status: ServiceStatus = {
                            switch statusString {
                            case "running": return .running
                            case "idle": return .idle
                            case "error": return .error
                            case "stopped": return .stopped
                            default: return .idle
                            }
                        }()

                        let lastRun = self.parseDate(from: serviceData["last_run"])
                        let nextRun = self.parseDate(from: serviceData["next_run"])
                        let cadence = serviceData["cadence"] as? Int

                        return AthenaService(name: name, status: status, lastRun: lastRun, nextRun: nextRun, cadence: cadence)
                    }

                    let status = AthenaStatus(services: services)
                    completion(.success(status))
                } else {
                    self.fallbackToMockStatus(completion: completion)
                }
            } catch {
                self.fallbackToMockStatus(completion: completion)
            }
        }
        task.resume()
    }

    private func fallbackToMockStatus(completion: @escaping (Result<AthenaStatus, Error>) -> Void) {
        // Use mock data when API unavailable
        let status = AthenaStatus(services: [
            AthenaService(name: "Memory Optimizer", status: .running, lastRun: Date().addingTimeInterval(-300), nextRun: Date().addingTimeInterval(3300), cadence: 3600),
            AthenaService(name: "Tribunal Monitor", status: .running, lastRun: Date().addingTimeInterval(-900), nextRun: Date().addingTimeInterval(0), cadence: 900),
            AthenaService(name: "Voice Wake Word", status: .running, lastRun: nil, nextRun: nil, cadence: nil),
            AthenaService(name: "Federation Sync", status: .idle, lastRun: Date().addingTimeInterval(-7200), nextRun: Date().addingTimeInterval(1800), cadence: 7200)
        ])
        completion(.success(status))
    }

    private func parseDate(from value: Any?) -> Date? {
        if let dateString = value as? String {
            let formatter = ISO8601DateFormatter()
            return formatter.date(from: dateString)
        }
        return nil
    }

    func getAlerts(completion: @escaping (Result<[AthenaAlert], Error>) -> Void) {
        // Mock implementation
        DispatchQueue.global().asyncAfter(deadline: .now() + 0.3) {
            let alerts = [
                AthenaAlert(id: "alert-1", timestamp: Date().addingTimeInterval(-1800), severity: .info, title: "Memory Optimization Complete", message: "Successfully optimized memory usage by 35%", acknowledged: true),
                AthenaAlert(id: "alert-2", timestamp: Date().addingTimeInterval(-600), severity: .warning, title: "High Memory Usage Detected", message: "Memory utilization at 85%. Optimization scheduled.", acknowledged: false)
            ]
            completion(.success(alerts))
        }
    }

    func getMetrics(completion: @escaping (Result<AthenaMetrics, Error>) -> Void) {
        // Mock implementation
        DispatchQueue.global().asyncAfter(deadline: .now() + 0.2) {
            let metrics = AthenaMetrics(
                memoryOptimizationSavings: 0.35,
                tribunalScansToday: 24,
                alertsTriggeredToday: 3,
                averageResponseTime: 0.8,
                systemHealthScore: 0.95
            )
            completion(.success(metrics))
        }
    }

    func acknowledgeAlert(_ alertId: String, completion: @escaping (Result<Void, Error>) -> Void) {
        // Mock implementation
        DispatchQueue.global().asyncAfter(deadline: .now() + 0.2) {
            completion(.success(()))
        }
    }

    func updateCadence(service: String, cadence: Int, completion: @escaping (Result<Void, Error>) -> Void) {
        // Mock implementation
        DispatchQueue.global().asyncAfter(deadline: .now() + 0.3) {
            completion(.success(()))
        }
    }

    func sendTestAlert(completion: @escaping (Result<Void, Error>) -> Void) {
        // Mock implementation
        DispatchQueue.global().asyncAfter(deadline: .now() + 0.1) {
            completion(.success(()))
        }
    }
}

struct AthenaStatus {
    let services: [AthenaService]
}
