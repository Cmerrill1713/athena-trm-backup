// MARK: - Alert Row

struct AlertRow: View {
    let alert: AthenaAlert

    var body: some View {
        HStack(spacing: 12) {
            Circle()
                .fill(alert.severity.color)
                .frame(width: 8, height: 8)

            VStack(alignment: .leading, spacing: 2) {
                Text(alert.title)
                    .font(.subheadline)
                    .lineLimit(1)
                Text(alert.timeAgo)
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }

            Spacer()

            if !alert.acknowledged {
                Circle()
                    .fill(Color.blue)
                    .frame(width: 6, height: 6)
            }
        }
        .padding(.vertical, 4)
    }
}

// MARK: - Navigation Destinations

enum DashboardDestination: Hashable {
    case systemHealth
    case alerts
    case metrics
    case settings
    case focus
    case calendar
    case learning
}

// MARK: - Modern Athena ViewModel

@MainActor
final class ModernAthenaViewModel: ObservableObject {
    // Core State
    @Published var services: [AthenaService] = []
    @Published var alerts: [AthenaAlert] = []
    @Published var systemHealth = SystemHealth()
    @Published var isConnected = false
    @Published var lastUpdate = Date()
    @Published var isQuietHoursActive = false
    @Published var queuedAlerts: [AthenaAlert] = []

    // Recent Activity
    @Published var recentActivity: [ActivityItem] = []

    // Private state
    private var monitoringTask: Task<Void, Never>?
    private var apiClient = ModernAthenaAPIClient()

    init() {
        loadInitialData()
    }

    func loadInitialData() {
        // Load mock data initially
        services = [
            AthenaService(name: "Memory Optimizer", status: .running, lastRun: Date().addingTimeInterval(-300), nextRun: Date().addingTimeInterval(3300), cadence: 3600),
            AthenaService(name: "Tribunal Monitor", status: .running, lastRun: Date().addingTimeInterval(-900), nextRun: Date().addingTimeInterval(0), cadence: 900),
            AthenaService(name: "Voice Wake Word", status: .running, lastRun: nil, nextRun: nil, cadence: nil),
            AthenaService(name: "Federation Sync", status: .idle, lastRun: Date().addingTimeInterval(-7200), nextRun: Date().addingTimeInterval(1800), cadence: 7200)
        ]

        alerts = [
            AthenaAlert(id: "alert-1", timestamp: Date().addingTimeInterval(-1800), severity: .info, title: "Memory Optimization Complete", message: "Successfully optimized memory usage by 35%", acknowledged: true),
            AthenaAlert(id: "alert-2", timestamp: Date().addingTimeInterval(-600), severity: .warning, title: "High Memory Usage Detected", message: "Memory utilization at 85%. Optimization scheduled.", acknowledged: false)
        ]

        recentActivity = [
            ActivityItem(id: "1", title: "Memory optimization completed", type: .system, timestamp: Date().addingTimeInterval(-1800)),
            ActivityItem(id: "2", title: "Tribunal scan finished", type: .security, timestamp: Date().addingTimeInterval(-900)),
            ActivityItem(id: "3", title: "Voice activation started", type: .service, timestamp: Date().addingTimeInterval(-600))
        ]
    }

    func startMonitoring() async {
        monitoringTask?.cancel()

        monitoringTask = Task {
            while !Task.isCancelled {
                await refreshAll()
                try? await Task.sleep(nanoseconds: 5_000_000_000) // 5 seconds
            }
        }
    }

    func stopMonitoring() {
        monitoringTask?.cancel()
        monitoringTask = nil
    }

    func refreshAll() async {
        do {
            // Concurrent data loading
            async let servicesResult = apiClient.fetchServices()
            async let alertsResult = apiClient.fetchAlerts()
            async let healthResult = apiClient.fetchSystemHealth()

            let (services, alerts, health) = try await (servicesResult, alertsResult, healthResult)

            self.services = services
            self.alerts = alerts
            self.systemHealth = health
            self.isConnected = true
            self.lastUpdate = Date()

            // Add to recent activity
            addActivity("Dashboard refreshed", .system)

        } catch {
            self.isConnected = false
            addActivity("Connection failed", .error)
        }
    }

    func acknowledgeAlert(_ alert: AthenaAlert) async {
        do {
            try await apiClient.acknowledgeAlert(alert.id)
            addActivity("Alert acknowledged: \(alert.title)", .user)
            await refreshAll()
        } catch {
            addActivity("Failed to acknowledge alert", .error)
        }
    }

    func acknowledgeAllAlerts() {
        let unacknowledged = alerts.filter { !$0.acknowledged }
        for alert in unacknowledged {
            Task { await acknowledgeAlert(alert) }
        }
        addActivity("All alerts acknowledged", .user)
    }

    func sendTestAlert() async {
        do {
            try await apiClient.sendTestAlert()
            addActivity("Test alert sent", .system)
            await refreshAll()
        } catch {
            addActivity("Failed to send test alert", .error)
        }
    }

    func openLogs() {
        let logDir = "/tmp"
        NSWorkspace.shared.open(URL(fileURLWithPath: logDir))
        addActivity("Logs opened", .user)
    }

    private func addActivity(_ title: String, _ type: ActivityType) {
        let activity = ActivityItem(id: UUID().uuidString, title: title, type: type, timestamp: Date())
        recentActivity.insert(activity, at: 0)
        if recentActivity.count > 50 {
            recentActivity = Array(recentActivity.prefix(50))
        }
    }
}

// MARK: - Supporting Models

struct SystemHealth {
    var isHealthy: Bool = true
    var memorySavings: Double = 0.35
    var tribunalScansToday: Int = 24
    var alertsTriggeredToday: Int = 3
    var averageResponseTime: Double = 0.8
    var healthScore: Double = 0.95
}

struct ActivityItem: Identifiable {
    let id: String
    let title: String
    let type: ActivityType
    let timestamp: Date
}

enum ActivityType {
    case system, user, security, error, service

    var color: Color {
        switch self {
        case .system: return .blue
        case .user: return .green
        case .security: return .orange
        case .error: return .red
        case .service: return .purple
        }
    }
}

// MARK: - API Client

class ModernAthenaAPIClient {
    private let baseURL = "http://localhost:8009"

    func fetchServices() async throws -> [AthenaService] {
        try await Task.sleep(nanoseconds: 500_000_000) // Simulate network delay
        return [
            AthenaService(name: "Memory Optimizer", status: .running, lastRun: Date().addingTimeInterval(-300), nextRun: Date().addingTimeInterval(3300), cadence: 3600),
            AthenaService(name: "Tribunal Monitor", status: .running, lastRun: Date().addingTimeInterval(-900), nextRun: Date().addingTimeInterval(0), cadence: 900),
            AthenaService(name: "Voice Wake Word", status: .running, lastRun: nil, nextRun: nil, cadence: nil),
            AthenaService(name: "Federation Sync", status: .idle, lastRun: Date().addingTimeInterval(-7200), nextRun: Date().addingTimeInterval(1800), cadence: 7200)
        ]
    }

    func fetchAlerts() async throws -> [AthenaAlert] {
        try await Task.sleep(nanoseconds: 300_000_000)
        return [
            AthenaAlert(id: "alert-1", timestamp: Date().addingTimeInterval(-1800), severity: .info, title: "Memory Optimization Complete", message: "Successfully optimized memory usage by 35%", acknowledged: true),
            AthenaAlert(id: "alert-2", timestamp: Date().addingTimeInterval(-600), severity: .warning, title: "High Memory Usage Detected", message: "Memory utilization at 85%. Optimization scheduled.", acknowledged: false)
        ]
    }

    func fetchSystemHealth() async throws -> SystemHealth {
        try await Task.sleep(nanoseconds: 200_000_000)
        return SystemHealth()
    }

    func acknowledgeAlert(_ alertId: String) async throws {
        try await Task.sleep(nanoseconds: 200_000_000)
    }

    func sendTestAlert() async throws {
        try await Task.sleep(nanoseconds: 100_000_000)
    }
}

