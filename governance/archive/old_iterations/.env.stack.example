# Stack Configuration
# Copy to .env.stack and customize

# === Ports ===
UAT_PORT=8181
ATH_PORT=8090
BRIDGE_PORT=8014

# === Authentication ===
UAT_TOKEN=supersecret
ATH_TOKEN=supersecret
BRIDGE_TOKEN=

# === Environment ===
ENV=dev
USE_MOCK=0

# === Derived URLs (auto-computed, no need to change) ===
# UAT_BASE=http://127.0.0.1:${UAT_PORT}
# ATHENA_BASE=http://127.0.0.1:${ATH_PORT}
# BRIDGE_BASE=http://127.0.0.1:${BRIDGE_PORT}
