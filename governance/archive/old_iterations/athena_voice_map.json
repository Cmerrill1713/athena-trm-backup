{
  "ship it": "make athena-canary && make athena-promote",
  "backtrack": "make athena-rollback",
  "stabilize": "make athena-stabilize",
  "push it through": "make athena-override",
  
  "bring it online": "make stack-up",
  "bring everything online": "make stack-up",
  "shut it down": "make stack-down",
  "shut everything down": "make stack-down",
  "start fresh": "make stack-restart",
  "restart everything": "make stack-restart",
  "status check": "make tier4-proof",
  
  "smoke it": "make athena-tests-smoke",
  "run smoke tests": "make athena-tests-smoke",
  "shake the tree": "make chaos-test",
  "run chaos": "make chaos-test",
  "proof it": "make tier4-proof",
  "run proof": "make tier4-proof",
  "ghost check": "make truth",
  "check for ghosts": "make truth",
  "kill ghosts": "make nuke-ports",
  "nuke everything": "make nuke-ports && make stack-up",
  
  "open the dashboard": "open http://localhost:3001",
  "open grafana": "open http://localhost:3001",
  "show me the numbers": "make watchdog-status && make stack-status",
  "show metrics": "curl -s http://127.0.0.1:8014/metrics | head -30",
  
  "lock it down": "make sec-check",
  "check the gate": "make athena-validate",
  "limit test": "make guardrails-smoke",
  "test guardrails": "make guardrails-smoke",
  
  "launch ui": "make frontend-up",
  "reset ui": "make frontend-restart",
  "ui status": "curl http://127.0.0.1:8014/ready",
  
  "watchdog status": "make watchdog-status",
  "show watchdog": "make watchdog-status",
  "watchdog logs": "make watchdog-logs",
  "show incidents": "make watchdog-incidents",
  "enable autopilot": "make watchdog-install",
  "disable autopilot": "make watchdog-stop",
  
  "run tests": "make athena-tests",
  "full tests": "make athena-tests",
  "backend tests": "make athena-tests-backends",
  "all tests": "make athena-tests-all",
  
  "validate stack": "make stack-validate",
  "health check": "make stack-status",
  "what's running": "make truth",
  "show truth": "make truth",
  
  "shadow traffic ten percent": "make canary-shadow-10",
  "shadow traffic": "make canary-shadow-10",
  "generate incident report": "make watchdog-incidents && make truth",
  "tail errors": "tail -50 logs/*.log | grep -i error",
  "tail errors last five minutes": "tail -300 logs/*.log | grep -i error",
  "create rollback point": "git tag -a rollback-$(date +%s) -m 'Manual rollback point'",
  "snapshot traces": "curl -s http://127.0.0.1:8014/traces > traces-$(date +%s).json",
  "show me incidents": "make watchdog-incidents",
  "restart the ui": "make frontend-restart",
  "restart bridge": "pkill -TERM -f uvicorn.*adapter && make stack-up",
  "restart athena": "pkill -TERM -f uvicorn.*athena && make stack-up",
  "point app at canary": "export API_BASE=http://127.0.0.1:8015 && make app",
  "open logs": "tail -f logs/*.log",
  "clear logs": "truncate -s 0 logs/*.log",
  "nuke everything": "make nuke-ports && make stack-up",
  "emergency restart": "make nuke-ports && make stack-up && make truth"
}

