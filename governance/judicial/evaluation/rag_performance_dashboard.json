{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "id": null,
  "panels": [
    {
      "type": "stat",
      "title": "RAG hit ratio (5m)",
      "datasource": "Prometheus",
      "id": 21,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(increase(rag_hits_total[5m])) / clamp_min(sum(increase(rag_queries_total[5m])), 1)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 0.6, "color": "yellow"},
              {"value": 0.8, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "RAG latency p95",
      "datasource": "Prometheus",
      "id": 22,
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.5, "color": "yellow"},
              {"value": 2.0, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Embedding queue depth",
      "datasource": "Prometheus",
      "id": 23,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "avg(embedding_queue_depth)",
          "legendFormat": "Queue depth",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG query rate",
      "datasource": "Prometheus",
      "id": 24,
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(rag_queries_total[5m]))",
          "legendFormat": "Queries/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Citation validity %",
      "datasource": "Prometheus",
      "id": 25,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "100 * sum(increase(rag_valid_citations_total[1h])) / clamp_min(sum(increase(rag_total_citations_total[1h])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 80, "color": "yellow"},
              {"value": 95, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Top queries (last 1h)",
      "datasource": "Prometheus",
      "id": 26,
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "topk(10, sum by (query_category) (increase(rag_queries_total[1h])))",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["rag", "latency", "performance"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "",
  "title": "RAG Performance",
  "uid": "neuroforge-rag",
  "version": 1
}
