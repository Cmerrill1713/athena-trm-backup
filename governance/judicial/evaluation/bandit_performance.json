{
  "dashboard": {
    "title": "NeuroForge - Bandit Prompt Optimization",
    "schemaVersion": 39,
    "tags": ["neuroforge", "bandit", "optimization"],
    "timezone": "browser",
    "panels": [
      {
        "type": "stat",
        "title": "Bandit Trials (Last Hour)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(bandit_trials_total[1h]))",
            "legendFormat": "trials/hour"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 10 },
                { "color": "green", "value": 50 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
      },
      {
        "type": "stat",
        "title": "Feedback Events (Last Hour)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(feedback_events_total[1h]))",
            "legendFormat": "feedback/hour"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "green", "value": 20 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
      },
      {
        "type": "stat",
        "title": "Bandit Selection Time (p95)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(bandit_selection_seconds_bucket[5m]))",
            "legendFormat": "p95 selection time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 0.01 },
                { "color": "red", "value": 0.1 }
              ]
            },
            "unit": "s"
          }
        },
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
      },
      {
        "type": "table",
        "title": "Prompt Variant Performance",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(bandit_trials_total[1h])) by (variant)",
            "legendFormat": "{{variant}} trials"
          },
          {
            "expr": "sum(rate(bandit_wins_total[1h])) by (variant)",
            "legendFormat": "{{variant}} wins"
          }
        ],
        "transformations": [
          {
            "id": "joinByField",
            "options": {
              "byField": "variant",
              "mode": "outer"
            }
          },
          {
            "id": "calculateField",
            "options": {
              "mode": "reduceRow",
              "reduce": {
                "values": false,
                "fields": "/.*/"
              },
              "replaceFields": false
            }
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "Win Rate",
              "mode": "binary",
              "binary": {
                "left": "bandit_wins_total",
                "operator": "/",
                "right": "bandit_trials_total",
                "reducer": "sum"
              },
              "replaceFields": true
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 0.3 },
                { "color": "green", "value": 0.5 }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Win Rate"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percentunit"
                }
              ]
            }
          ]
        },
        "gridPos": { "h": 12, "w": 12, "x": 0, "y": 8 }
      },
      {
        "type": "barchart",
        "title": "Feedback Signal Distribution",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(feedback_events_total[1h])) by (signal_type)",
            "legendFormat": "{{signal_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        },
        "gridPos": { "h": 12, "w": 12, "x": 12, "y": 8 }
      },
      {
        "type": "graph",
        "title": "Bandit Learning Over Time",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(bandit_wins_total[5m])) by (variant) / sum(rate(bandit_trials_total[5m])) by (variant)",
            "legendFormat": "{{variant}} win rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0.3 },
                { "color": "yellow", "value": 0.4 },
                { "color": "green", "value": 0.5 }
              ]
            },
            "unit": "percentunit"
          }
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 }
      },
      {
        "type": "heatmap",
        "title": "Feedback Processing Latency",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(feedback_processing_seconds_bucket[5m])",
            "legendFormat": "{{le}}s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0.1 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 }
      },
      {
        "type": "stat",
        "title": "Best Performing Variant",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "topk(1, sum(rate(bandit_wins_total[1h])) by (variant) / sum(rate(bandit_trials_total[1h])) by (variant))",
            "legendFormat": "{{variant}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "refresh": "30s",
    "schemaVersion": 39,
    "version": 1,
    "links": []
  }
}
