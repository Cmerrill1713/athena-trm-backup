{
  "version": "v1.6",
  "timestamp": "2025-10-14T18:30:00-05:00",
  "receipt_schema": {
    "required_fields": [
      "ece",
      "entropy_drift",
      "autoheal",
      "fix_confidence",
      "edge_case_score",
      "consistency_index",
      "tests_pass",
      "critical_errors"
    ],
    "optional_fields": [
      "build_success_rate",
      "temp_sensitivity",
      "violation_rate"
    ]
  },
  "field_definitions": {
    "ece": {
      "type": "number",
      "range": [0.0, 1.0],
      "description": "Expected Calibration Error - measures how well predicted probabilities match actual outcomes",
      "critical_threshold": 0.06,
      "action_on_exceed": "disable_tot_got"
    },
    "entropy_drift": {
      "type": "number",
      "range": [0.0, 1.0],
      "description": "Measure of system entropy change over time",
      "critical_threshold": 0.10,
      "action_on_exceed": "flag_for_review"
    },
    "autoheal": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer",
          "description": "Total auto-heal errors encountered"
        },
        "rules_matched": {
          "type": "integer",
          "description": "Number of auto-heal rules that matched"
        },
        "fixes_applied": {
          "type": "integer",
          "description": "Number of fixes successfully applied"
        }
      },
      "hard_fail_condition": "errors > 0 AND rules_matched == 0"
    },
    "fix_confidence": {
      "type": "number",
      "range": [0.0, 1.0],
      "description": "Confidence score for auto-fix operations",
      "thresholds": {
        "soft_fail": [0.6, 0.8],
        "pass": [0.8, 1.0]
      }
    },
    "edge_case_score": {
      "type": "number",
      "range": [0.0, 1.0],
      "description": "Performance score on edge cases and adversarial inputs"
    },
    "consistency_index": {
      "type": "number",
      "range": [0.0, 1.0],
      "description": "Measure of output consistency across similar inputs"
    },
    "tests_pass": {
      "type": "integer",
      "description": "Number of tests that passed",
      "minimum_required": "class_min"
    },
    "critical_errors": {
      "type": "integer",
      "description": "Number of critical errors detected",
      "zero_required": true
    }
  },
  "verdict_logic": {
    "hard_fail": [
      "ece > 0.06",
      "autoheal.errors > 0 AND autoheal.rules_matched == 0",
      "critical_errors > 0",
      "fix_confidence < 0.6 AND critical_errors > 0"
    ],
    "soft_fail": [
      "0.6 <= fix_confidence < 0.8",
      "entropy_drift >= 0.10"
    ],
    "pass": [
      "ece <= 0.06",
      "autoheal.errors == 0 OR autoheal.rules_matched > 0",
      "fix_confidence >= 0.8",
      "tests_pass >= class_min",
      "critical_errors == 0"
    ]
  },
  "governance_actions": {
    "disable_tot_got": {
      "condition": "ece > 0.06",
      "description": "Disable Tree-of-Thought and Graph-of-Thought due to poor calibration"
    },
    "flag_for_review": {
      "condition": "entropy_drift >= 0.10",
      "description": "Flag for human review due to significant entropy drift"
    },
    "require_human_review": {
      "condition": "0.6 <= fix_confidence < 0.8",
      "description": "Require human review for medium-confidence fixes"
    }
  }
}
