<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.neuroforge.snapshot.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>ORCHESTRATOR_PATH/scripts/snapshot_backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BACKUP_PASSPHRASE</key><string>REPLACE_WITH_SECURE_VALUE</string>
    <key>OUT_DIR</key><string>ORCHESTRATOR_PATH/releases/backups</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>ORCHESTRATOR_PATH/state/backup.log</string>
  <key>StandardErrorPath</key><string>ORCHESTRATOR_PATH/state/backup.err</string>
  <key>RunAtLoad</key><true/>
</dict></plist>
