FROM python:3.11-slim

LABEL org.opencontainers.image.title="MCP Store Service"
LABEL org.opencontainers.image.description="Unified validation results storage for NeuroForge Platform"
LABEL org.opencontainers.image.version="0.1.0"

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY app.py .
COPY mcp_server.py .
COPY init_weaviate_schema.sh .

# Non-root user for security
RUN useradd -m -u 1000 mcpstore && \
    chown -R mcpstore:mcpstore /app
USER mcpstore

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8411/health').raise_for_status()"

EXPOSE 8411

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8411"]

