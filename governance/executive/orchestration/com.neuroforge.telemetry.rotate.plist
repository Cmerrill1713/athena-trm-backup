<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.neuroforge.telemetry.rotate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>ORCHESTRATOR_PATH/tools/telemetry_rotate.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TELEMETRY_DB</key><string>ORCHESTRATOR_PATH/state/telemetry.sqlite</string>
    <key>DAYS_TO_KEEP</key><string>14</string>
    <key>MAX_ROWS</key><string>50000</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>7</integer><!-- Sunday -->
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>ORCHESTRATOR_PATH/state/telemetry.rotate.log</string>
  <key>StandardErrorPath</key><string>ORCHESTRATOR_PATH/state/telemetry.rotate.err</string>
  <key>RunAtLoad</key><true/>
</dict></plist>
