                <key>ActionName</key>
                <string>Run Shell Script</string>
                <key>ActionParameters</key>
                <dict>
                    <key>COMMAND_STRING</key>
                    <string>#!/bin/zsh
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAUNCHER_SCRIPT="$SCRIPT_DIR/athena_launcher.sh"

if [ -f "$LAUNCHER_SCRIPT" ]; then
    "$LAUNCHER_SCRIPT" backend
else
    osascript -e 'display dialog "Athena launcher script not found. Please ensure athena_launcher.sh is in the same directory as the Quick Action." buttons {"OK"} default button "OK" with icon stop'
fi</string>
