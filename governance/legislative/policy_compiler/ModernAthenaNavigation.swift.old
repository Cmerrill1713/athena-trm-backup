import SwiftUI

// MARK: - Modern Navigation Stack with Async/Await

struct ModernAthenaDashboard: View {
    @State private var navigationPath = NavigationPath()
    @StateObject private var dashboardVM = AthenaDashboardViewModel()

    var body: some View {
        NavigationStack(path: $navigationPath) {
            DashboardHomeView()
                .navigationTitle("Athena Dashboard")
                .navigationBarTitleDisplayMode(.inline)
                .toolbar {
                    ToolbarItem(placement: .topBarTrailing) {
                        Menu {
                            Button {
                                navigationPath.append(Destination.settings)
                            } label: {
                                Label("Settings", systemImage: "gear")
                            }

                            Button {
                                navigationPath.append(Destination.health)
                            } label: {
                                Label("System Health", systemImage: "heart.circle")
                            }

                            Divider()

                            Button {
                                Task { await dashboardVM.refreshAll() }
                            } label: {
                                Label("Refresh All", systemImage: "arrow.clockwise")
                            }
                        } label: {
                            Image(systemName: "ellipsis.circle")
                        }
                    }
                }
                .navigationDestination(for: Destination.self) { destination in
                    switch destination {
                    case .health:
                        SystemHealthView()
                            .environmentObject(dashboardVM)
                    case .settings:
                        DashboardSettingsView()
                            .environmentObject(dashboardVM)
                    case .alerts:
                        AlertsDetailView()
                            .environmentObject(dashboardVM)
                    case .metrics:
                        MetricsDetailView()
                            .environmentObject(dashboardVM)
                    }
                }
        }
        .environmentObject(dashboardVM)
        .task {
            await dashboardVM.loadInitialData()
        }
    }
}

// MARK: - Navigation Destinations

enum Destination: Hashable {
    case health
    case settings
    case alerts
    case metrics
}

// MARK: - Home Dashboard View

struct DashboardHomeView: View {
    @EnvironmentObject private var dashboardVM: AthenaDashboardViewModel

    var body: some View {
        ScrollView {
            VStack(spacing: 20) {
                // Status Overview
                StatusOverviewCard()
                    .environmentObject(dashboardVM)

                // Quick Actions
                QuickActionsGrid()

                // Recent Alerts
                RecentAlertsCard()
                    .environmentObject(dashboardVM)

                // System Metrics
                MetricsSummaryCard()
                    .environmentObject(dashboardVM)
            }
            .padding()
        }
    }
}

// MARK: - Status Overview Card

struct StatusOverviewCard: View {
    @EnvironmentObject private var dashboardVM: AthenaDashboardViewModel

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            HStack {
                Label("System Status", systemImage: "circle.grid.3x3.fill")
                    .font(.headline)
                Spacer()
                StatusIndicator(isHealthy: dashboardVM.systemHealth.isHealthy)
            }

            HStack(spacing: 20) {
                StatusMetricView(
                    title: "Services",
                    value: "\(dashboardVM.services.filter { $0.status == .running }.count)/\(dashboardVM.services.count)",
                    icon: "server.rack",
                    color: .blue
                )

                StatusMetricView(
                    title: "Active Alerts",
                    value: "\(dashboardVM.alerts.filter { !$0.acknowledged }.count)",
                    icon: "exclamationmark.triangle",
                    color: dashboardVM.alerts.contains { !$0.acknowledged && $0.severity == .critical } ? .red : .orange
                )

                StatusMetricView(
                    title: "Memory Saved",
                    value: dashboardVM.systemHealth.memorySavings.formatted(.percent),
                    icon: "memorychip",
                    color: .green
                )
            }
        }
        .padding()
        .background(.ultraThinMaterial)
        .clipShape(RoundedRectangle(cornerRadius: 12))
    }
}

struct StatusIndicator: View {
    let isHealthy: Bool

    var body: some View {
        HStack(spacing: 4) {
            Circle()
                .fill(isHealthy ? Color.green : Color.red)
                .frame(width: 8, height: 8)
            Text(isHealthy ? "Healthy" : "Issues")
                .font(.caption)
                .foregroundStyle(.secondary)
        }
    }
}

struct StatusMetricView: View {
    let title: String
    let value: String
    let icon: String
    let color: Color

    var body: some View {
        VStack(spacing: 4) {
            Image(systemName: icon)
                .foregroundStyle(color)
                .font(.title2)
            Text(value)
                .font(.title3.bold())
                .foregroundStyle(.primary)
            Text(title)
                .font(.caption)
                .foregroundStyle(.secondary)
        }
        .frame(maxWidth: .infinity)
    }
}

