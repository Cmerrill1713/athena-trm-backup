// MARK: - View Models with Async/Await

@MainActor
final class AthenaDashboardViewModel: ObservableObject {
    @Published var services: [AthenaService] = []
    @Published var alerts: [AthenaAlert] = []
    @Published var systemHealth = SystemHealth()

    private let apiClient = ModernAthenaAPIClient()

    func loadInitialData() async {
        // Load data concurrently
        async let servicesResult = apiClient.fetchServices()
        async let alertsResult = apiClient.fetchAlerts()
        async let healthResult = apiClient.fetchSystemHealth()

        do {
            let (services, alerts, health) = try await (servicesResult, alertsResult, healthResult)
            self.services = services
            self.alerts = alerts
            self.systemHealth = health
        } catch {
            print("Failed to load initial data: \(error)")
            // Could show error state here
        }
    }

    func refreshAll() async {
        await loadInitialData()

        // Check for critical alerts and trigger pop-out windows
        checkForCriticalEvents()
    }

    private func checkForCriticalEvents() {
        // Check for critical alerts
        let criticalAlerts = alerts.filter { !$0.acknowledged && $0.severity == .critical }
        if !criticalAlerts.isEmpty {
            triggerCriticalAlertWindow(criticalAlerts.first!)
        }

        // Check for tribunal decisions needed (simulate for demo)
        if shouldShowTribunalDecision() {
            triggerTribunalDecisionWindow()
        }

        // Check for system emergencies
        if systemHealth.healthScore < 0.5 {
            triggerSystemEmergencyWindow()
        }
    }

    private func shouldShowTribunalDecision() -> Bool {
        // In real implementation, check for pending tribunal cases from API
        // For demo purposes, simulate occasionally having tribunal decisions
        return Bool.random() && Bool.random() // ~25% chance
    }

    private func triggerCriticalAlertWindow(_ alert: AthenaAlert) {
        DispatchQueue.main.async {
            NSApp.activate(ignoringOtherApps: true)
            NotificationCenter.default.post(
                name: NSNotification.Name("ShowCriticalAlert"),
                object: nil,
                userInfo: ["alert": alert]
            )
        }
    }

    private func triggerTribunalDecisionWindow() {
        DispatchQueue.main.async {
            NSApp.activate(ignoringOtherApps: true)
            NotificationCenter.default.post(
                name: NSNotification.Name("ShowTribunalDecision"),
                object: nil
            )
        }
    }

    private func triggerSystemEmergencyWindow() {
        DispatchQueue.main.async {
            NSApp.activate(ignoringOtherApps: true)
            NotificationCenter.default.post(
                name: NSNotification.Name("ShowSystemEmergency"),
                object: nil
            )
        }
    }

    func acknowledgeAlert(_ alert: AthenaAlert) async {
        do {
            try await apiClient.acknowledgeAlert(alert.id)
            // Refresh alerts after acknowledgment
            self.alerts = try await apiClient.fetchAlerts()
        } catch {
            print("Failed to acknowledge alert: \(error)")
        }
    }

    func sendTestAlert() async {
        do {
            try await apiClient.sendTestAlert()
            // Refresh alerts to show the test alert
            self.alerts = try await apiClient.fetchAlerts()
        } catch {
            print("Failed to send test alert: \(error)")
        }
    }
}

// MARK: - Modern API Client with Async/Await

class ModernAthenaAPIClient {
    private let baseURL = "http://localhost:8009"
    private let session: URLSession

    init() {
        let config = URLSessionConfiguration.default
        config.timeoutIntervalForRequest = 5.0
        config.timeoutIntervalForResource = 10.0
        self.session = URLSession(configuration: config)
    }

    func fetchServices() async throws -> [AthenaService] {
        guard let url = URL(string: "\(baseURL)/status") else {
            throw URLError(.badURL)
        }

        let (data, response) = try await session.data(from: url)

        guard let httpResponse = response as? HTTPURLResponse,
              httpResponse.statusCode == 200 else {
            throw URLError(.badServerResponse)
        }

        // Parse response and return services
        // This would be the actual parsing logic
        return [
            AthenaService(name: "Memory Optimizer", status: .running, lastRun: Date().addingTimeInterval(-300), nextRun: Date().addingTimeInterval(3300), cadence: 3600),
            AthenaService(name: "Tribunal Monitor", status: .running, lastRun: Date().addingTimeInterval(-900), nextRun: Date().addingTimeInterval(0), cadence: 900),
            AthenaService(name: "Voice Wake Word", status: .running, lastRun: nil, nextRun: nil, cadence: nil),
            AthenaService(name: "Federation Sync", status: .idle, lastRun: Date().addingTimeInterval(-7200), nextRun: Date().addingTimeInterval(1800), cadence: 7200)
        ]
    }

    func fetchAlerts() async throws -> [AthenaAlert] {
        // Simulate network delay
        try await Task.sleep(nanoseconds: 300_000_000) // 0.3 seconds

        return [
            AthenaAlert(id: "alert-1", timestamp: Date().addingTimeInterval(-1800), severity: .info, title: "Memory Optimization Complete", message: "Successfully optimized memory usage by 35%", acknowledged: true),
            AthenaAlert(id: "alert-2", timestamp: Date().addingTimeInterval(-600), severity: .warning, title: "High Memory Usage Detected", message: "Memory utilization at 85%. Optimization scheduled.", acknowledged: false)
        ]
    }

    func fetchSystemHealth() async throws -> SystemHealth {
        // Simulate network delay
        try await Task.sleep(nanoseconds: 200_000_000) // 0.2 seconds

        return SystemHealth(
            isHealthy: true,
            memorySavings: 0.35,
            tribunalScansToday: 24,
            alertsTriggeredToday: 3,
            averageResponseTime: 0.8,
            healthScore: 0.95
        )
    }

    func acknowledgeAlert(_ alertId: String) async throws {
        // Simulate network delay
        try await Task.sleep(nanoseconds: 200_000_000) // 0.2 seconds
        // In real implementation, this would make an API call
    }

    func sendTestAlert() async throws {
        // Simulate network delay
        try await Task.sleep(nanoseconds: 100_000_000) // 0.1 seconds
        // In real implementation, this would make an API call
    }
}

// MARK: - Data Models

struct SystemHealth {
    var isHealthy: Bool = true
    var memorySavings: Double = 0
    var tribunalScansToday: Int = 0
    var alertsTriggeredToday: Int = 0
    var averageResponseTime: Double = 0
    var healthScore: Double = 1.0

    var healthScoreDescription: String {
        String(format: "%.1f%%", healthScore * 100)
    }

    var memorySavingsDescription: String {
        String(format: "%.1f%%", memorySavings * 100)
    }

    var responseTimeDescription: String {
        String(format: "%.2fs", averageResponseTime)
    }
}

