{
  "version": "2",
  "defaults": {
    "provider": "router",
    "latency_budget_ms": 2500,
    "max_tokens": 1024
  },
  "vision": {
    "enabled": true,
    "providers": [
      {
        "name": "fastvlm",
        "base": "http://127.0.0.1:8811",
        "weight": 0.7,
        "modes": ["describe", "ocr", "qa"]
      },
      {
        "name": "ollama-vision",
        "base": "http://127.0.0.1:11434",
        "weight": 0.3,
        "modes": ["describe", "ocr"]
      }
    ],
    "strategy": "health_then_latency",
    "timeouts_ms": {
      "health": 800,
      "inference": 30000
    }
  },
  "chat": {
    "enabled": true,
    "providers": [
      {
        "name": "ollama",
        "base": "http://127.0.0.1:11434",
        "bucket": "fast"
      },
      {
        "name": "mlx",
        "base": "http://127.0.0.1:8877",
        "bucket": "balanced"
      },
      {
        "name": "trm",
        "base": "http://127.0.0.1:3033",
        "bucket": "reasoning"
      }
    ],
    "classifier": "TaskClassifier.v1",
    "strategy": "bucket_then_latency"
  },
  "tasks": {
    "chat.smalltalk": {
      "provider": "llm_router",
      "tier": "fast",
      "requires_tools": false
    },
    "chat.coding": {
      "provider": "llm_router",
      "tier": "accurate",
      "requires_tools": true
    },
    "chat.reasoning": {
      "provider": "trm_router",
      "depth": "auto",
      "budget_ms": 5000
    },
    "vision.describe": {
      "provider": "vision_router",
      "modality": "vision"
    },
    "vision.ocr": {
      "provider": "vision_router",
      "modality": "vision",
      "task_type": "ocr"
    },
    "vision.chart": {
      "provider": "vision_router",
      "modality": "vision",
      "task_type": "chart"
    },
    "audio.tts": {
      "provider": "tts_proxy"
    },
    "rag.query": {
      "provider": "rag_router",
      "dedupe": true,
      "rerank": "cross-encoder"
    }
  },
  "providers": {
    "vision_router": {
      "endpoint": "http://localhost:8014/api/vision/route"
    },
    "llm_router": {
      "endpoint": "http://localhost:8014/api/chat"
    },
    "trm_router": {
      "endpoint": "http://localhost:8014/api/trm/route"
    },
    "rag_router": {
      "endpoint": "http://localhost:8088/api/rag/search"
    },
    "tts_proxy": {
      "endpoint": "http://localhost:8888/api/tts/speak"
    },
    "router": {
      "endpoint": "http://localhost:8014/api/route"
    }
  },
  "circuit_breaker": {
    "open_threshold": 5,
    "half_open_after_ms": 30000,
    "success_threshold": 2
  },
  "fallbacks": [
    {
      "match": {
        "http": [500, 503],
        "timeout_ms": 2500
      },
      "to": "router"
    }
  ]
}
