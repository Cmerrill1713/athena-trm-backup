# Prometheus configuration for TRM Evolution monitoring

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'trm-evolution'

# Load alert rules
rule_files:
  - /etc/prometheus/trm.rules.yml
  - /etc/prometheus/fastvlm.rules.yml
  - /etc/prometheus/canary.rules.yml
  - /etc/prometheus/task_based_grading.rules.yml
  - /etc/prometheus/auto_promotion.rules.yml

# Scrape configurations
scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'router'
    static_configs:
      - targets: ['127.0.0.1:8080']   # your /metrics endpoint port
    metrics_path: /metrics
    scrape_interval: 10s

  - job_name: 'fastvlm'
    static_configs:
      - targets: ['127.0.0.1:8811']   # FastVLM vision server
    metrics_path: /metrics
    scrape_interval: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']
