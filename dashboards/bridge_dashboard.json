{
  "dashboard": {
    "title": "NeuroForge Bridge - Real Mode",
    "tags": ["bridge", "neuroforge", "real-mode"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(bridge_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "label": "req/sec",
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "title": "Latency (p50/p95/p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(bridge_latency_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(bridge_latency_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(bridge_latency_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {
            "label": "seconds",
            "format": "s"
          }
        ],
        "alert": {
          "name": "High p95 Latency",
          "conditions": [
            {
              "evaluator": {
                "params": [0.25],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              }
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "p95 latency exceeded 250ms SLO",
          "noDataState": "no_data"
        }
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(bridge_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "5xx {{endpoint}}"
          },
          {
            "expr": "rate(bridge_requests_total{status=~\"4..\"}[5m])",
            "legendFormat": "4xx {{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "label": "errors/sec",
            "format": "short"
          }
        ],
        "alert": {
          "name": "High Error Rate",
          "conditions": [
            {
              "evaluator": {
                "params": [0.01],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              }
            }
          ],
          "message": "Error rate > 1%"
        }
      },
      {
        "id": 4,
        "title": "Circuit Breaker State",
        "type": "stat",
        "targets": [
          {
            "expr": "bridge_breaker_state",
            "legendFormat": "{{backend}}"
          }
        ],
        "options": {
          "valueMappings": [
            {
              "value": 0,
              "text": "CLOSED",
              "color": "green"
            },
            {
              "value": 1,
              "text": "OPEN",
              "color": "red"
            },
            {
              "value": 2,
              "text": "HALF-OPEN",
              "color": "yellow"
            }
          ]
        }
      },
      {
        "id": 5,
        "title": "Auth Failures (401s)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(bridge_requests_total{status=\"401\"}[5m])",
            "legendFormat": "401 {{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "label": "failures/sec",
            "format": "short"
          }
        ],
        "alert": {
          "name": "Auth Failures",
          "conditions": [
            {
              "evaluator": {
                "params": [0.1],
                "type": "gt"
              }
            }
          ],
          "message": "Auth failures detected - possible token issue"
        }
      },
      {
        "id": 6,
        "title": "Mode Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (mode) (rate(bridge_requests_total[5m]))",
            "legendFormat": "{{mode}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Top Endpoints by Latency",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, rate(bridge_latency_seconds_bucket[5m])))",
            "format": "table"
          }
        ]
      },
      {
        "id": 8,
        "title": "Backend Health",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"uat\"}",
            "legendFormat": "UAT"
          },
          {
            "expr": "up{job=\"athena\"}",
            "legendFormat": "Athena"
          },
          {
            "expr": "up{job=\"bridge\"}",
            "legendFormat": "Bridge"
          }
        ],
        "options": {
          "valueMappings": [
            {
              "value": 1,
              "text": "UP",
              "color": "green"
            },
            {
              "value": 0,
              "text": "DOWN",
              "color": "red"
            }
          ]
        }
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    }
  }
}
