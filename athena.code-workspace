{
  "folders": [
    { "path": ".", "name": "🏠 Root" },
    
    // Core Systems
    { "path": "governance", "name": "⚖️ Governance" },
    { "path": "orchestrator", "name": "🎯 Orchestrator" },
    { "path": "agi_core", "name": "🧠 AGI Core" },
    { "path": "workflows", "name": "🔄 Workflows" },
    
    // Services
    { "path": "monitoring", "name": "📊 Monitoring" },
    { "path": "scripts", "name": "🛠️ Scripts" },
    { "path": "tests", "name": "🧪 Tests" },
    
    // Documentation
    { "path": "docs", "name": "📚 Docs" },
    { "path": "RUNBOOKS", "name": "📖 Runbooks" },
    
    // Infrastructure
    { "path": "docker", "name": "🐳 Docker" },
    { "path": "config", "name": "⚙️ Config" },
    
    // Submodules (if present)
    { "path": "kokoro", "name": "🎤 Kokoro" },
    { "path": "pydantic-ai", "name": "🤖 Pydantic AI" },
    { "path": "A2A", "name": "🔗 A2A" }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/backups": true,
      "**/archive/old_iterations": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/backups": true,
      "**/archive/old_iterations": true,
      "**/*.log": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.venv/**": true,
      "**/backups/**": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
      ".",
      "governance",
      "orchestrator",
      "agi_core",
      "workflows",
      "common"
    ],
    "python.analysis.diagnosticMode": "workspace",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests"
    ],
    "go.toolsManagement.autoUpdate": true,
    "gopls": {
      "directoryFilters": [
        "-**/dist",
        "-**/build",
        "-**/target",
        "-**/.venv",
        "-**/node_modules"
      ]
    },
    "rust-analyzer.checkOnSave.command": "clippy",
    "rust-analyzer.procMacro.enable": true,
    "typescript.tsserver.maxTsServerMemory": 4096,
    "search.useIgnoreFiles": true,
    "search.followSymlinks": true,
    "files.associations": {
      "*.yaml": "yaml",
      "*.yml": "yaml",
      "Makefile*": "makefile",
      ".cursorrules": "markdown"
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "golang.go",
      "rust-lang.rust-analyzer",
      "redhat.vscode-yaml",
      "timonwong.shellcheck",
      "ms-azuretools.vscode-docker"
    ]
  }
}

