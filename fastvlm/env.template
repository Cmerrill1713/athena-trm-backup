# FastVLM + Canary Configuration Template
# Copy this to .env.fastvlm and customize
# Usage: set -a; source .env.fastvlm; set +a

# FastVLM Server
FASTVLM_ROOT="/Users/christianmerrill/Documents/GitHub/fastvlm/ml-fastvlm"
FASTVLM_MODEL="checkpoints/fastvlm_1.5b_stage3"
FASTVLM_HOST="127.0.0.1"
FASTVLM_PORT="8811"
FASTVLM_ENDPOINT="http://127.0.0.1:8811"

# Observability
ENV="prod"
BUILD_SHA="$(git rev-parse --short HEAD 2>/dev/null || echo 'local')"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/athena_db"

# Canary Deployment
CANARY_ENABLED=false              # Set to 'true' to enable
CANARY_MODEL="fastvlm-1.5b"       # Model to test
CANARY_PERCENT=0                  # % of traffic (0-100)
CANARY_REQUIRE_HEALTH=true        # Skip if circuit open

# Circuit Breaker (per model)
CB_WINDOW=50                      # Last N requests per model
CB_FAIL_RATE=0.2                  # Open if >20% failures
CB_P95_MS=3000                    # Open if p95 > 3s
CB_OPEN_SECONDS=300               # Stay open 5 min

