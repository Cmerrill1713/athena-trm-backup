# Athena Production Makefile Targets
# Auto-generated production workflow

.PHONY: capability-registry gateway-denylist-deprecated ship-check canary-start canary-watch canary-promote canary-rollback metrics-snapshot

# ============================================================================
# 0) CATALOG REALITY
# ============================================================================

capability-registry:  ## Generate capability registry (CSV/JSON)
	@echo "📋 Generating capability registry..."
	@python3 generate_capability_registry.py
	@echo "✅ Registry: capability_registry.csv"

# ============================================================================
# 1) LOCK DOWN PUBLIC SURFACE
# ============================================================================

gateway-denylist-deprecated:  ## Block deprecated endpoints
	@echo "🚫 Generating gateway denylist..."
	@python3 create_gateway_denylist.py
	@echo "✅ Denylist: gateway_denylist.json"
	@echo "⚠️  Apply to gateway/nginx to activate"

# ============================================================================
# 2) HARD GATES (Contract + Perf)
# ============================================================================

ship-check:  ## Run all promotion gates before deploy
	@echo "🎯 Running ship-check gates..."
	@echo ""
	@echo "1. Contract tests (OpenAPI)..."
	@python3 test_final_comprehensive.py || exit 1
	@echo "✅ Contract tests passed"
	@echo ""
	@echo "2. Performance gates..."
	@./check_performance_gates.sh || exit 1
	@echo "✅ Performance gates passed"
	@echo ""
	@echo "3. RAG quality gates..."
	@./check_rag_gates.sh || exit 1
	@echo "✅ RAG gates passed"
	@echo ""
	@echo "🎉 ALL GATES PASSED - Ready to ship!"

# ============================================================================
# 3) CANARY DEPLOYMENT
# ============================================================================

canary-start:  ## Start canary at 5%
	@echo "🐤 Starting canary deployment (5%)..."
	@curl -X POST http://localhost:9113/canary/start -d '{"percentage": 5}'
	@echo "✅ Canary started at 5%"

canary-watch:  ## Watch canary metrics (run in separate terminal)
	@echo "👀 Watching canary metrics..."
	@watch -n 2 'curl -s http://localhost:9113/canary | jq .'

canary-promote:  ## Promote canary to next level
	@echo "⬆️  Promoting canary..."
	@curl -X POST http://localhost:9113/canary/promote
	@echo "✅ Canary promoted"

canary-rollback:  ## Emergency rollback
	@echo "🔙 ROLLING BACK CANARY!"
	@curl -X POST http://localhost:9113/canary/rollback
	@echo "✅ Rolled back to stable"

# ============================================================================
# 4) BASELINE SNAPSHOT
# ============================================================================

metrics-snapshot:  ## Capture baseline metrics
	@echo "📸 Capturing metrics snapshot..."
	@mkdir -p metrics/baselines
	@curl -s http://localhost:9113/metrics > metrics/baselines/router_$(date +%Y%m%d_%H%M%S).txt
	@curl -s http://localhost:8080/metrics > metrics/baselines/uai_$(date +%Y%m%d_%H%M%S).txt
	@curl -s http://localhost:8098/metrics > metrics/baselines/learning_$(date +%Y%m%d_%H%M%S).txt
	@echo "✅ Snapshot saved to metrics/baselines/"

# ============================================================================
# VALIDATION
# ============================================================================

validate-all:  ## Full system validation
	@echo "🔍 Running full system validation..."
	@python3 test_complete_expanded.py
	@echo "✅ Validation complete!"

# ============================================================================
# HELP
# ============================================================================

help-production:  ## Show production workflow
	@echo "🚀 ATHENA PRODUCTION WORKFLOW"
	@echo ""
	@echo "Pre-deploy:"
	@echo "  1. make capability-registry         - Catalog all features"
	@echo "  2. make gateway-denylist-deprecated - Block stale endpoints"
	@echo "  3. make ship-check                  - Run all gates"
	@echo ""
	@echo "Canary deploy:"
	@echo "  4. make canary-start    - Start at 5%"
	@echo "  5. make canary-watch    - Monitor (in separate terminal)"
	@echo "  6. make canary-promote  - Promote to 25%, 50%, 100%"
	@echo "  7. make metrics-snapshot - Save baseline"
	@echo ""
	@echo "Emergency:"
	@echo "  make canary-rollback - Instant rollback"


# ============================================================================
# ATHENA DEV DAEMON (Universal Copilot)
# ============================================================================

athena-up:  ## Start Athena dev daemon
	@echo "🤖 Starting Athena Dev Daemon..."
	@docker-compose up -d athena-devd
	@sleep 3
	@curl -s http://localhost:8765/healthz | jq .
	@echo "✅ Athena daemon ready at http://localhost:8765"

athena-index:  ## Rebuild code index
	@echo "📚 Rebuilding code index..."
	@curl -s -X POST http://localhost:8765/index/rebuild | jq .
	@echo "✅ Index rebuild started"

athena-assist:  ## Test Athena from terminal
	@echo "🤖 Testing Athena assist..."
	@./.athena/adapters/terminal.sh "explain the router service"

athena-hook-install:  ## Install git hooks
	@echo "🪝 Installing Athena git hooks..."
	@mkdir -p .git/hooks
	@echo '#!/bin/bash' > .git/hooks/pre-commit
	@echo 'make ship-check' >> .git/hooks/pre-commit
	@chmod +x .git/hooks/pre-commit
	@echo "✅ Pre-commit hook installed"

athena-adapter-vscode:  ## Show VS Code adapter installation
	@echo "📦 VS Code/Cursor Adapter"
	@echo ""
	@echo "1. Open VS Code/Cursor in this repo"
	@echo "2. Install dependencies:"
	@echo "   cd .athena/adapters && npm init -y && npm install node-fetch"
	@echo "3. Compile: tsc vscode-cursor.ts"
	@echo "4. Add keybinding: Cmd+K Cmd+A → athena.explainAndFix"
	@echo ""
	@echo "Or just use terminal: make athena-assist"

athena-adapter-neovim:  ## Show Neovim adapter installation
	@echo "📦 Neovim Adapter"
	@echo ""
	@echo "Add to your init.lua or init.vim:"
	@echo '  require("athena").setup()'
	@echo ""
	@echo "Copy neovim.lua to:"
	@echo "  ~/.config/nvim/lua/athena.lua"
	@echo ""
	@echo "Then use: <leader>aa to call Athena"

help-athena:  ## Show Athena copilot help
	@echo "🤖 ATHENA UNIVERSAL COPILOT"
	@echo ""
	@echo "Start daemon:"
	@echo "  make athena-up           - Start background daemon"
	@echo ""
	@echo "Use from editors:"
	@echo "  VS Code/Cursor: Cmd+K Cmd+A"
	@echo "  Neovim: <leader>aa"
	@echo "  Terminal: athena-assist 'your question'"
	@echo ""
	@echo "Maintenance:"
	@echo "  make athena-index        - Rebuild code index"
	@echo "  make athena-hook-install - Install git hooks"
	@echo ""
	@echo "See: ATHENA_COPILOT_README.md"


# ============================================================================
# GO MIGRATION - Shadow, Compare, Promote
# ============================================================================

go-shadow-up:  ## Bring up Go gateway/router in shadow mode
	@echo "🔬 Starting Go services in shadow mode..."
	@docker-compose -f docker-compose.yml -f docker-compose.shadow.yml up -d go-router go-gateway
	@sleep 5
	@echo "✅ Shadow stack running:"
	@echo "   - Go Router: http://localhost:9115 (shadows Python 9113)"
	@echo "   - Go Gateway: http://localhost:8081 (shadows Python 8080)"

go-shadow-down:  ## Stop Go shadow services
	@echo "Stopping Go shadow services..."
	@docker-compose -f docker-compose.yml -f docker-compose.shadow.yml down go-router go-gateway

go-parity:  ## Run shadow comparison and check parity
	@echo "🔬 Running parity tests..."
	@mkdir -p artifacts
	@python3 scripts/shadow_compare.py
	@echo ""
	@echo "Results saved to: artifacts/shadow_results.json"

go-k6:  ## Run k6 load test against Go gateway
	@echo "📊 Running k6 load test against Go gateway..."
	@mkdir -p artifacts
	@k6 run --vus 50 --duration 5m --env GATEWAY_URL=http://localhost:8081 scripts/k6_load_test.js
	@echo ""
	@echo "Results saved to: artifacts/k6_results.json"

go-k6-compare:  ## Compare k6 results between Python and Go
	@echo "📊 Comparing Python vs Go performance..."
	@echo ""
	@echo "Python (port 8080):"
	@k6 run --vus 50 --duration 2m --env GATEWAY_URL=http://localhost:8080 scripts/k6_load_test.js --out json=artifacts/k6_python.json
	@echo ""
	@echo "Go (port 8081):"
	@k6 run --vus 50 --duration 2m --env GATEWAY_URL=http://localhost:8081 scripts/k6_load_test.js --out json=artifacts/k6_go.json
	@echo ""
	@echo "Results saved to: artifacts/k6_python.json, artifacts/k6_go.json"

go-promote-5:  ## Promote Go gateway to 5% traffic
	@echo "⬆️  Promoting Go gateway to 5% traffic..."
	@echo "TODO: Implement traffic splitting in Nginx/load balancer"
	@echo "Feature flag: GATEWAY_IMPL_GO_PCT=5"

go-promote-25:  ## Promote Go gateway to 25% traffic
	@echo "⬆️  Promoting Go gateway to 25% traffic..."
	@echo "TODO: Implement traffic splitting"
	@echo "Feature flag: GATEWAY_IMPL_GO_PCT=25"

go-promote-50:  ## Promote Go gateway to 50% traffic
	@echo "⬆️  Promoting Go gateway to 50% traffic..."
	@echo "TODO: Implement traffic splitting"
	@echo "Feature flag: GATEWAY_IMPL_GO_PCT=50"

go-promote-100:  ## Promote Go gateway to 100% traffic
	@echo "🎉 Promoting Go gateway to 100% traffic!"
	@echo "TODO: Implement traffic splitting"
	@echo "Feature flag: GATEWAY_IMPL_GO_PCT=100"
	@echo ""
	@echo "⚠️  Keep Python stack running for 48h for rollback safety"

go-rollback:  ## Emergency rollback to Python stack
	@echo "🔙 EMERGENCY ROLLBACK TO PYTHON!"
	@echo "Setting Go traffic to 0%..."
	@echo "TODO: Implement instant rollback"
	@echo "Feature flag: GATEWAY_IMPL_GO_PCT=0"
	@echo "✅ All traffic back to Python"

go-full-test:  ## Run complete Go validation suite
	@echo "🧪 Running complete Go validation..."
	@make go-shadow-up
	@sleep 10
	@make go-parity
	@make go-k6
	@echo ""
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@echo "📊 VALIDATION COMPLETE"
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@echo ""
	@echo "Check results:"
	@echo "  - Parity: artifacts/shadow_results.json"
	@echo "  - Load test: artifacts/k6_results.json"

help-go:  ## Show Go migration help
	@echo "🚀 GO MIGRATION WORKFLOW"
	@echo ""
	@echo "Phase 1: Shadow & Validate"
	@echo "  make go-shadow-up     - Start Go services in shadow mode"
	@echo "  make go-parity        - Test parity (goal: ≥99%)"
	@echo "  make go-k6            - Load test (goal: p95 ≥20% better)"
	@echo "  make go-full-test     - Run complete validation"
	@echo ""
	@echo "Phase 2: Progressive Rollout"
	@echo "  make go-promote-5     - 5% traffic to Go"
	@echo "  make go-promote-25    - 25% traffic to Go"
	@echo "  make go-promote-50    - 50% traffic to Go"
	@echo "  make go-promote-100   - 100% traffic to Go"
	@echo ""
	@echo "Emergency:"
	@echo "  make go-rollback      - Instant rollback to Python"
	@echo ""
	@echo "See: GO_MIGRATION_PLAN.md"

