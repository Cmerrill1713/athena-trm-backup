FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY agi_core/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy AGI Core and dependencies
COPY agi_core/ /app/agi_core/
COPY common/ /app/common/
COPY infra/ /app/infra/

# Create state directories
RUN mkdir -p /app/state/agi/{context,bundles,experts,workflows,delegation,metrics}

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV AGI_STATE_DIR=/app/state/agi

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=20s \
  CMD python -c "import requests; requests.get('http://localhost:8000/health').raise_for_status()"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "agi_core.agi_service:app", "--host", "0.0.0.0", "--port", "8000"]
