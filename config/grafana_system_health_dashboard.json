{
    "dashboard": {
        "id": null,
        "title": "Athena System Health - Single View",
        "tags": [
            "athena",
            "system",
            "health"
        ],
        "style": "dark",
        "timezone": "browser",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "🎯 System Health Status",
                "type": "stat",
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "up{job=\"agi-core\"} * 100",
                        "legendFormat": "AGI Core",
                        "refId": "A"
                    },
                    {
                        "expr": "up{job=\"rag-gateway\"} * 100",
                        "legendFormat": "RAG Gateway",
                        "refId": "B"
                    },
                    {
                        "expr": "up{job=\"trm-service\"} * 100",
                        "legendFormat": "TRM Service",
                        "refId": "C"
                    },
                    {
                        "expr": "up{job=\"uai\"} * 100",
                        "legendFormat": "UAI",
                        "refId": "D"
                    },
                    {
                        "expr": "up{job=\"mcp\"} * 100",
                        "legendFormat": "MCP",
                        "refId": "E"
                    },
                    {
                        "expr": "up{job=\"router\"} * 100",
                        "legendFormat": "Router",
                        "refId": "F"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "red",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 50
                                },
                                {
                                    "color": "green",
                                    "value": 100
                                }
                            ]
                        },
                        "unit": "percent",
                        "min": 0,
                        "max": 100
                    }
                },
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ],
                        "fields": ""
                    },
                    "orientation": "horizontal",
                    "textMode": "auto",
                    "colorMode": "value",
                    "graphMode": "area",
                    "justifyMode": "auto"
                }
            },
            {
                "id": 2,
                "title": "🚀 TRM Adaptive Policy Activity",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "increase(trm_policy_predictions_total[1h])",
                        "legendFormat": "Predictions/hour",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "short",
                        "min": 0
                    }
                },
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ],
                        "fields": ""
                    },
                    "orientation": "horizontal",
                    "textMode": "auto",
                    "colorMode": "value",
                    "graphMode": "area",
                    "justifyMode": "auto"
                }
            },
            {
                "id": 3,
                "title": "🧠 RAG Query Performance",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(rag_query_latency_ms_bucket[5m])) by (le))",
                        "legendFormat": "P95 Latency",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "green",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 200
                                },
                                {
                                    "color": "red",
                                    "value": 500
                                }
                            ]
                        },
                        "unit": "ms",
                        "min": 0
                    }
                },
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ],
                        "fields": ""
                    },
                    "orientation": "horizontal",
                    "textMode": "auto",
                    "colorMode": "value",
                    "graphMode": "area",
                    "justifyMode": "auto"
                }
            },
            {
                "id": 4,
                "title": "📊 Model Pool Hot-Swaps",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 12,
                    "x": 0,
                    "y": 12
                },
                "targets": [
                    {
                        "expr": "rate(model_pool_hotswaps_total[5m]) * 60",
                        "legendFormat": "Swaps/min",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "green",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 5
                                },
                                {
                                    "color": "red",
                                    "value": 20
                                }
                            ]
                        },
                        "unit": "short",
                        "min": 0
                    }
                },
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ],
                        "fields": ""
                    },
                    "orientation": "horizontal",
                    "textMode": "auto",
                    "colorMode": "value",
                    "graphMode": "area",
                    "justifyMode": "auto"
                }
            },
            {
                "id": 5,
                "title": "🎯 Overall System Score",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 12,
                    "x": 12,
                    "y": 12
                },
                "targets": [
                    {
                        "expr": "(up{job=\"agi-core\"} + up{job=\"rag-gateway\"} + up{job=\"trm-service\"} + up{job=\"uai\"} + up{job=\"mcp\"} + up{job=\"router\"}) / 6 * 100",
                        "legendFormat": "Health Score",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "red",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 80
                                },
                                {
                                    "color": "green",
                                    "value": 100
                                }
                            ]
                        },
                        "unit": "percent",
                        "min": 0,
                        "max": 100
                    }
                },
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ],
                        "fields": ""
                    },
                    "orientation": "horizontal",
                    "textMode": "auto",
                    "colorMode": "value",
                    "graphMode": "area",
                    "justifyMode": "auto"
                }
            }
        ]
    }
}