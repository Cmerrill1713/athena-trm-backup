// File: Sources/Config/ServiceRegistry.swift
import Foundation

struct ServiceRegistry {
    static let shared = ServiceRegistry()
    
    let base = URL(string: ProcessInfo.processInfo.environment["API_BASE"] ?? "http://127.0.0.1:8014")!
    
    // FIXED: RAG and Vision run on separate ports, NOT proxied through Bridge
    var ragURL: URL { 
        URL(string: "http://127.0.0.1:8015/api/rag/query")!  // ← Port 8015
    }
    
    var visionURL: URL { 
        URL(string: "http://127.0.0.1:8016/api/vision/describe")!  // ← Port 8016
    }
    
    var healthChecks: [String: URL] {
        [
            "bridge": base.appendingPathComponent("/ready"),
            "athena": URL(string: "http://127.0.0.1:8090/ready")!,
            "uat": URL(string: "http://127.0.0.1:8181/ready")!,
            "kokoro": URL(string: "http://127.0.0.1:8020/health")!
        ]
    }
    
    var optionalHealthChecks: [String: URL] {
        [
            "rag": URL(string: "http://127.0.0.1:8015/api/rag/health")!,
            "vision": URL(string: "http://127.0.0.1:8016/api/vision/health")!
        ]
    }
}
```

## 2. ChatViewEnhanced.swift - RAG Payload Fix ✅

```swift
// File: Sources/Features/ChatViewEnhanced.swift

@MainActor
private func injectRAGContext() async {
    guard let lastPrompt = messages.last(where: { $0.role == .user })?.content else {
        showToast(message: "⚠️ No user message to query")
        return
    }
    
    let url = ServiceRegistry.shared.ragURL
    // FIXED: RAG service expects {"query": "...", "k": N}, not {"query": "...", "top_k": N}
    let payload = ["query": lastPrompt, "k": 5] as [String : Any]
    guard let body = try? JSONSerialization.data(withJSONObject: payload) else { return }
    
    do {
        let (data, _) = try await api.post(url, body: body)
        if let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
           let hits = json["hits"] as? [[String: Any]] {
            let contexts = hits.compactMap { $0["text"] as? String }
            let context = contexts.joined(separator: "\n\n")
            input = input.isEmpty ? "Context:\n\(context)" : "\(input)\n\nContext:\n\(context)"
            showToast(message: "✅ RAG: \(hits.count) results")
        } else if let context = String(data: data, encoding: .utf8) {
            input = input.isEmpty ? "Context:\n\(context)" : "\(input)\n\nContext:\n\(context)"
            showToast(message: "✅ RAG context injected")
        }
    } catch {
        showToast(message: "⚠️ RAG error: \(error.localizedDescription)")
    }
}
```

## 3. Vision Payload Fix ✅

```swift
@MainActor
private func pickAndDescribeImage() async {
    guard let image = await ImagePickerHelper.pick() else {
        showToast(message: "⚠️ No image selected")
        return
    }
    
    guard let png = image.pngData() else {
        showToast(message: "⚠️ Could not encode image")
        return
    }
    
    let url = ServiceRegistry.shared.visionURL
    // Vision service expects base64 PNG
    let payload = ["image": png.base64EncodedString()]  // ← Key is "image", not "image_base64"
    guard let body = try? JSONEncoder().encode(payload) else { return }
    
    do {
        let (data, _) = try await api.post(url, body: body)
        if let desc = String(data: data, encoding: .utf8) {
            input = input.isEmpty ? desc : "\(input)\n\nImage: \(desc)"
            showToast(message: "✅ Image described")
        }
    } catch {
        showToast(message: "⚠️ Vision error: \(error.localizedDescription)")
    }
}
```

## 4. Enhanced Health Check ✅

```swift
@MainActor
private func probeAll() async {
    // Core services
    for (name, url) in ServiceRegistry.shared.healthChecks {
        let ok = await api.head(url)
        showToast(message: "\(name): \(ok ? "✅" : "⚠️")")
        try? await Task.sleep(nanoseconds: 300_000_000)
    }
    
    // Optional services (don't fail if down)
    for (name, url) in ServiceRegistry.shared.optionalHealthChecks {
        let ok = await api.head(url)
        if ok {
            showToast(message: "\(name): ✅")
            try? await Task.sleep(nanoseconds: 300_000_000)
        }
    }
}
```

