<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- NeuroForge Hardened Runtime Entitlements -->
  <!-- Non-sandboxed Developer ID app -->

  <!-- Disable App Sandbox (we need localhost network access) -->
  <key>com.apple.security.app-sandbox</key>
  <false/>

  <!-- Allow user to pick files/images -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Network client (backend API calls) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Hardened Runtime: Disable JIT (security) -->
  <key>com.apple.security.cs.allow-jit</key>
  <false/>

  <!-- Hardened Runtime: Disable library validation bypass -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <false/>

  <!-- Hardened Runtime: Disable unsigned executable memory -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <false/>

  <!-- No microphone needed (set to true if adding voice input) -->
  <key>com.apple.security.device.audio-input</key>
  <false/>

  <!-- No AppleEvents automation needed -->
  <key>com.apple.security.automation.apple-events</key>
  <false/>

  <!-- Debugging disabled in release -->
  <key>com.apple.security.get-task-allow</key>
  <false/>

  <!-- No DYLD env vars -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <false/>
</dict>
</plist>
