# NeuroForge DMG Build Configuration
# Copy this to .env and fill in your values

# Apple Developer Team ID (find at: developer.apple.com → Membership)
TEAM_ID=YOUR_TEAM_ID_HERE

# Bundle identifier (must match Info.plist)
BUNDLE_ID=com.neuroforge.app

# Xcode scheme name
APP_SCHEME=NeuroForgeApp

# App name (as it appears in Products)
APP_NAME=NeuroForgeApp

# Signing identity (exact name from Keychain)
# Example: "Developer ID Application: Your Name (TEAM123)"
SIGN_IDENTITY="Developer ID Application: Your Name (YOUR_TEAM_ID_HERE)"

# Notary profile name (created with notarytool store-credentials)
NOTARY_PROFILE=neuroforge-notary

# ===== Optional: Sparkle Auto-Updates (future) =====
# SPARKLE_FEED_URL=https://yourdomain.com/appcast.xml
# SPARKLE_PUBLIC_KEY=<base64-encoded-public-key>
